
#!/data/data/com.termux/files/usr/bin/bash

API_KEY=$(sops -d "$REPO/.secrets/common.yaml" | yq '.GEMINI_API')

MODEL_NAME="gemini-3.1-flash-lite"
ENDPOINT="https://generativelanguage.googleapis.com/v1beta/models/$MODEL_NAME:generateContent"

GREEN=$'\e[1;32m'
BLUE=$'\e[1;34m'
RED=$'\e[1;31m'
CYAN=$'\e[1;36m'
YELLOW=$'\e[1;33m'
GRAY=$'\e[0;90m'
RESET=$'\e[0m'

JSON_DIR="$HOME/.local/share/json"
mkdir -p "$JSON_DIR"

HISTORY_FILE="$JSON_DIR/chat_history.json"
PAYLOAD_FILE="$JSON_DIR/payload.json"
RESPONSE_FILE="$JSON_DIR/response.json"

[[ -f "$HISTORY_FILE" ]] || echo "[]" > "$HISTORY_FILE"

cleanup() { echo "${RED}Sesi berakhir.${RESET}"; exit; }
trap cleanup SIGINT

render_md() {
    # Non-interaktif, langsung print & exit, gak ada pager/TUI
    glow -w "$(tput cols)" -
}

clear
echo "${BLUE}==========================================${RESET}"
echo "${BLUE} 🤖 Gemini AI - Token Monitor ${RESET}"
echo " Model: $MODEL_NAME"
echo "${BLUE}==========================================${RESET}"

while true; do
    printf "\n${GREEN}You:${RESET} "
    read user_input

    if [[ "$user_input" == "exit" || "$user_input" == "q" ]]; then cleanup; fi
    if [[ "$user_input" == "reset" ]]; then
        echo "[]" > "$HISTORY_FILE"
        echo "${YELLOW}[!] Ingatan dihapus.${RESET}"
        continue
    fi
    if [[ "$user_input" == "rechat" ]]; then
        echo "${GRAY}--- Riwayat Chat ---${RESET}"
        jq -r '.[] | (if .role=="user" then "**🧑 You**\n" else "**🤖 Gemini**\n" end) + .parts[0].text + "\n"' "$HISTORY_FILE" | render_md
        continue
    fi
    if [[ -z "$user_input" ]]; then continue; fi

    jq --arg txt "$user_input" '. += [{"role": "user", "parts": [{"text": $txt}]}]' "$HISTORY_FILE" > tmp.json && mv tmp.json "$HISTORY_FILE"
    jq '{contents: .}' "$HISTORY_FILE" > "$PAYLOAD_FILE"

    printf "${CYAN}Gemini sedang berpikir...${RESET}"

    curl -s -X POST "$ENDPOINT" \
         -H "Content-Type: application/json" \
         -H "x-goog-api-key: $API_KEY" \
         -d @"$PAYLOAD_FILE" > "$RESPONSE_FILE"

    printf "\r\033[K"

    answer=$(jq -r '.candidates[0].content.parts[0].text // empty' "$RESPONSE_FILE")
    token_count=$(jq -r '.usageMetadata.totalTokenCount // 0' "$RESPONSE_FILE")

    if [[ -z "$answer" ]]; then
        error_msg=$(jq -r '.error.message // empty' "$RESPONSE_FILE")
        if [[ -n "$error_msg" ]]; then
            echo "${RED}[API Error]: $error_msg${RESET}"
        else
            echo "${RED}[Error]: Tidak ada respon.${RESET}"
        fi
    else
        echo "$answer" | glow --tui=true -w "$(tput cols)" -
        
        echo "${BLUE}Gemini:${RESET}"
        echo "$answer" | render_md
        echo "${YELLOW}[Realtime Token : $token_count]${RESET}"

        jq --arg txt "$answer" '. += [{"role": "model", "parts": [{"text": $txt}]}]' "$HISTORY_FILE" > tmp.json && mv tmp.json "$HISTORY_FILE"
    fi
done
