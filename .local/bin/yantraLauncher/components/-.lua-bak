-- UI Menu
-- lists Chapters
local function show_lists()
  print("Silakan pilih chapter :\n")
  for i, chapter in ipairs(Helix_Ebook) do
    print(string.format("[ %d ]  %s", i - 1, chapter))
  end
  print("\n=========================== lists(l) quit(q)")
end

-- Cover
local function show_menu()
  binding.exec("clear")
  print("================== Helix ===================")
  print("--------------------------------------------")
  print(" Selamat datang di Ebook pembelajaran Helix\n")
  show_lists()
end

local function ensure_and_validate_file(path)
  local f, err = io.open(path, "r")
  
  -- 1. Blok Pembuatan File (Jika file belum ada)
  if not f then
    f = io.open(path, "w")
    if f then
        f:write(HEADER)
        f:write("\n")
        f:close()
        return true
    else
        binding.exec("echo -w ============ ⚠️ ACCESE DENIED =============")
        binding.exec("echo -e 'Restricted Launcher Permissions: The launcher cannot access this system file due to limited permissions. Please ensure you are only accessing files generated by the launcher itself.'")
        print("\nHow to fix this:\n")
        print("1. Delete the existing file.")
        print("2. Re-run the script and select your target\n   index.")
        print("3. The launcher will automatically\n   regenerate the file using the correct\n   template.\n")
        binding.exec("echo -s Once regenerated, you can manually edit the file without any issues.")
        print("\n--------------------------------------------")
        print("=========================== lists(l) quit(q)")
        return false
    end
  end

--  -- 2. Blok Validasi (File ada → Cek isinya)
--  -- Gunakan pcall untuk mencoba membaca file dengan aman
--  local status, first_line = pcall(function() return f:read("*l") end)
