--  -- 3. (beda konten)    -> Jika isinya tidak sama dengan HEADER
--  if not status or not first_line or first_line ~= target_header then
--    binding.exec("echo ⚠️ PERINGATAN KEAMANAN")
--    print("File ini bukan dibuat oleh Yantra Launcher.")
--    print("Silakan hapus file dan jalankan ulang script.\n")
--    return false
--  end

  return true
end


-- Reader
local function read_file(path)
  local f = io.open(path, "r")
  if not f then
    print("❌ Gagal membuka ebook.")
    return
  end

  local content = f:read("*a")
  f:close()

  print(content .. "\n")
  print("--------------------------------------------")
  print("=================== exit(q) lists(l) === END")
end

-- ensure_dir(BASE_PATH)
show_menu()

while true do  
  local user_input = input()  
  
  -- 1. Cek perintah khusus (String) terlebih dahulu
  if user_input == "q" then
      print("\n👋 Keluar dari Ebook. Selamat ngoding!\n")
      break
  elseif user_input == "l" then
      binding.exec("clear")
      show_lists() -- Tambahkan () agar fungsi terpanggil
      return
  -- 2. Jika bukan perintah khusus, baru proses sebagai angka
  else
      local index = tonumber(user_input)
      
      -- Validasi apakah input adalah angka DAN berada dalam rentang array yang benar
      -- Asumsi: User menginput index 0-based (0, 1, 2...), jadi array diakses dengan index+1
      if index and index >= 0 and index < #Helix_Ebook then  
          local chapter_name = Helix_Ebook[index + 1]  
          local file_path = BASE_PATH .. chapter_name .. ".txt"  
            
          binding.exec("clear")  
          if ensure_and_validate_file(file_path) then  
              read_file(file_path)  
          end 
      else  
          -- Jika bukan angka, atau angka di luar jangkauan
          print("\n⚠️ Pilihan tidak valid!\n")  
      end  
  end  
end
